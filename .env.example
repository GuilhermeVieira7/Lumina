# Copie para .env (cp .env.example .env) e troque as senhas antes de usar de verdade.
POSTGRES_USER=lumina
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=lumina
# Chave que assina os logins (JWT). Use um texto longo e aleatório.
SECRET_KEY=troque-esta-chave-por-um-texto-longo
# Opcional: outros endereços que podem chamar a API (separados por vírgula).
# Deixe vazio quando o frontend é servido pelo próprio servidor (o normal).
CORS_ORIGINS=
# pgAdmin (http://localhost:5050): login do painel web do banco.
# Ao abrir o servidor "Lumina" lá dentro, a senha pedida é a POSTGRES_PASSWORD.
PGADMIN_EMAIL=admin@lumina.dev
PGADMIN_PASSWORD=troque-esta-senha-do-pgadmin

# "Pergunte a IA" no Painel dos Adultos (Google Gemini, opcional).
# Crie a chave em https://aistudio.google.com/apikey. Sem ela, o painel responde pelas regras do Lumina.
# Nao sao enviados o nome, a foto nem o diario da crianca, so dados agregados.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
