# Copie para .env (cp .env.example .env) e troque as senhas antes de usar de verdade.
POSTGRES_USER=lumina
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=lumina
# Chave que assina os logins (JWT). Use um texto longo e aleatório.
SECRET_KEY=troque-esta-chave-por-um-texto-longo
# Opcional: outros endereços que podem chamar a API (separados por vírgula).
# Deixe vazio quando o frontend é servido pelo próprio servidor (o normal).
CORS_ORIGINS=
